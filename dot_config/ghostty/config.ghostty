theme = Gruvbox Material Dark

# window
maximize = true
window-padding-balance = true
window-padding-color = extend

# font
font-family = Lilex
font-size = 13
font-style = Medium
adjust-cell-height = 10%

# cursor
cursor-style-blink = false
adjust-cursor-thickness = 2
custom-shader = shaders/cursor_tail.glsl
