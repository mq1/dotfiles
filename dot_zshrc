# set up mise (package manager)
eval "$(~/.local/bin/mise activate zsh)"

# set up antidote (zsh plugin manager)
[[ -d "$HOME/.antidote" ]] || git clone --depth=1 https://github.com/mattmc3/antidote.git "$HOME/.antidote"
source "$HOME/.antidote/antidote.zsh"
antidote load

# case insensitive tab completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# history
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# history search
source <(fzf --zsh)

# aliases
alias ls="ls --color=auto"
alias vi="nvim"
alias tzst="tar -c -v --zstd --options zstd:compression-level=19,zstd:threads=0 -f"

